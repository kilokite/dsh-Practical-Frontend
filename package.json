{
  "name": "dsh-practical-frontend",
  "version": "0.3.0",
  "description": "Practical front-end tweaks for DeepSeek Harness: tint workspace rows and bookmark conversation excerpts with in-place highlighting.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "workspace",
    "bookmark",
    "highlight"
  ],
  "license": "MIT",
  "author": {
    "name": "kilokite"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kilokite/dsh-Practical-Frontend.git"
  },
  "homepage": "https://github.com/kilokite/dsh-Practical-Frontend#readme",
  "bugs": {
    "url": "https://github.com/kilokite/dsh-Practical-Frontend/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
